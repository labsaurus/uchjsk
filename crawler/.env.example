# Copy to .env and adjust. Every limit can be changed here without touching code.
# Real environment variables take precedence over this file.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://crawler:change-me@localhost:5432/playstore
DB_POOL_MAX=4

# --- Target / identity ------------------------------------------------------
PLAY_BASE_URL=https://play.google.com
PLAY_LANG=en
PLAY_COUNTRY=us
# Identify yourself honestly and give site operators a way to reach you.
USER_AGENT=PlayStoreResearchCrawler/1.0 (+mailto:you@example.com)
# Token matched against robots.txt "User-agent:" groups.
ROBOTS_USER_AGENT_TOKEN=PlayStoreResearchCrawler

# --- Concurrency (adaptive, always within [MIN, MAX]) ------------------------
CONCURRENCY=5
MIN_CONCURRENCY=1
MAX_CONCURRENCY=8

# --- Global rate limit (applies across all workers) -------------------------
MAX_REQUESTS_PER_MINUTE=30
# Minimum spacing between request starts, plus 0..REQUEST_JITTER_MS random.
MIN_REQUEST_INTERVAL_MS=1500
REQUEST_JITTER_MS=750
# Upper bound for adaptive slow-down (interval x multiplier).
MAX_SLOWDOWN_MULTIPLIER=16

# --- HTTP / retries (408, 429, 500, 502, 503, 504 and network errors) -------
REQUEST_TIMEOUT_MS=20000
MAX_RESPONSE_BYTES=4194304
MAX_RETRIES=4
BACKOFF_BASE_MS=2000
BACKOFF_MAX_MS=120000
# If Retry-After asks for longer than this, give up on the item for this run.
RETRY_AFTER_MAX_MS=600000

# --- Adaptive throttling ----------------------------------------------------
ADAPTIVE_WINDOW_SIZE=50
ADAPTIVE_ERROR_RATE_THRESHOLD=0.1
ADAPTIVE_STABLE_ERROR_RATE=0.02
ADAPTIVE_INCREASE_INTERVAL_MS=120000
ADAPTIVE_DECREASE_COOLDOWN_MS=10000

# --- Circuit breaker --------------------------------------------------------
BREAKER_WINDOW_SIZE=30
BREAKER_MIN_SAMPLES=10
BREAKER_FAILURE_THRESHOLD=0.5
BREAKER_COOLDOWN_MS=300000
BREAKER_MAX_COOLDOWN_MS=3600000
BREAKER_HALF_OPEN_SUCCESSES=3
# After this many trips in one invocation the run pauses until the next timer run.
BREAKER_MAX_TRIPS_PER_RUN=5

# --- Hard block (CAPTCHA / "unusual traffic" / HTTP 403) ---------------------
# The crawler stops immediately and sends nothing until the cooldown expires.
BLOCK_COOLDOWN_HOURS=24

# --- Scheduling -------------------------------------------------------------
MAX_APPS_PER_RUN=5000
CLAIM_BATCH_SIZE=25
LEASE_MS=900000
MIN_RECRAWL_HOURS=24
MAX_RECRAWL_HOURS=336
NOT_FOUND_RECRAWL_HOURS=720
NOT_FOUND_MAX_STRIKES=3
FAILED_RECRAWL_HOURS=6
MAX_RUN_DURATION_MINUTES=1200

# --- Discovery --------------------------------------------------------------
DISCOVERY_ENABLED=true
MAX_DISCOVERED_PER_RUN=2000
MAX_TOTAL_APPS=200000

# --- Process ----------------------------------------------------------------
SHUTDOWN_GRACE_MS=30000
CHECKPOINT_INTERVAL_MS=15000
LOG_LEVEL=info
